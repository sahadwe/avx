{
  "name": "No Name Video Editor",
  "short_name": "No Name",
  "description": "Mobile-first video editor",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
